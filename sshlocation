#!/usr/bin/env bash
# ============================================================================
# sshlocation: Guardian & Stratus Live Tracking Service Runner
# Starts the server and persistent tunnel, renews the tracking session,
# and opens the tracking dashboard in the default browser.
#
# Usage:
#   sshlocation          - Start service, connect tunnel, and open dashboard
#   sshlocation stop     - Stop service & tunnel (links return 404 Not Found)
#   sshlocation status   - Display active session, URLs, and phone connection
#   sshlocation rebuild  - Recompile Android APK with active tunnel
# ============================================================================
set -e

# Target workspace directory
REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

SERVER_DIR="$REPO_DIR/server"
DATA_DIR="$SERVER_DIR/data"
WEATHER_DIR="$REPO_DIR/weather"
TOKEN_FILE="$SERVER_DIR/.safety_token"
CONFIG_FILE="$DATA_DIR/tunnel.config"
PORT=8000

mkdir -p "$DATA_DIR"

# Read configured method (default: localhost.run)
METHOD="localhost.run"
SERVEO_SUBDOMAIN=""
NGROK_TOKEN=""
NGROK_DOMAIN=""
if [ -f "$CONFIG_FILE" ]; then
    while IFS='=' read -r key val; do
        case "$key" in
            METHOD) METHOD="$(echo "$val" | tr -d '[:space:]')" ;;
            SERVEO_SUBDOMAIN) SERVEO_SUBDOMAIN="$(echo "$val" | tr -d '[:space:]')" ;;
            NGROK_TOKEN) NGROK_TOKEN="$(echo "$val" | tr -d '[:space:]')" ;;
            NGROK_DOMAIN) NGROK_DOMAIN="$(echo "$val" | tr -d '[:space:]')" ;;
        esac
    done < "$CONFIG_FILE"
fi

# ----------------------------------------------------------------------------
# Command: stop
# ----------------------------------------------------------------------------
if [ "$1" == "stop" ]; then
    STOP_ALL=0
    if [ "$2" == "--all" ] || [ "$2" == "-a" ] || [ "$2" == "--tunnel" ]; then
        STOP_ALL=1
    fi

    echo "Stopping tracking service..."
    if [ -f "$TOKEN_FILE" ]; then
        TOK="$(cat "$TOKEN_FILE" | tr -d '[:space:]')"
        curl -s -X POST "http://127.0.0.1:$PORT/api/session/end" \
            -H "Authorization: Bearer $TOK" > /dev/null 2>&1 || true
    fi

    # Kill server on port 8000
    pkill -f "PORT=$PORT .*app.py" 2>/dev/null || true

    if [ "$STOP_ALL" -eq 1 ]; then
        echo "Tearing down public tunnel..."
        if [ -f "$DATA_DIR/ssh_tunnel.pid" ]; then
            kill "$(cat "$DATA_DIR/ssh_tunnel.pid")" 2>/dev/null || true
            rm -f "$DATA_DIR/ssh_tunnel.pid"
        fi
        pkill -f "tunnel_daemon.py" 2>/dev/null || true
        pkill -f "nokey@localhost.run" 2>/dev/null || true
        rm -f "$DATA_DIR/tunnel.url"

        if [ -f "$DATA_DIR/cf_tunnel.pid" ]; then
            kill "$(cat "$DATA_DIR/cf_tunnel.pid")" 2>/dev/null || true
            rm -f "$DATA_DIR/cf_tunnel.pid"
        fi
        pkill -f "cloudflared tunnel" 2>/dev/null || true
        echo "Service and public tunnel completely stopped."
    else
        echo "Service stopped."
        echo "Persistent tunnel domain remains reserved so your phone connection is preserved."
        echo "To tear down the tunnel completely, run: sshlocation stop --all"
    fi
    exit 0
fi

# ----------------------------------------------------------------------------
# Command: status
# ----------------------------------------------------------------------------
if [ "$1" == "status" ]; then
    echo "=================================================="
    echo "  Guardian & Stratus: Service Status              "
    echo "=================================================="
    echo "Configured Tunnel: $METHOD"
    if [ -f "$TOKEN_FILE" ]; then
        TOK="$(cat "$TOKEN_FILE" | tr -d '[:space:]')"
        echo "Safety Token     : $TOK"
        echo ""
        echo "Tracking Status  : Continuous & Permanent (Never expires)"
        echo ""
        if [ "$METHOD" == "cloudflare" ] && [ -n "$CF_DOMAIN" ]; then
            echo "Public URL       : https://$CF_DOMAIN/?token=$TOK"
        elif [ -f "$DATA_DIR/tunnel.url" ]; then
            echo "Public URL       : $(cat "$DATA_DIR/tunnel.url")/?token=$TOK"
        fi
        echo "Local Dashboard  : http://localhost:$PORT/?token=$TOK"
    else
        echo "No safety token configured. Run installer first."
    fi
    echo "=================================================="
    exit 0
fi

# ----------------------------------------------------------------------------
# Command: rebuild
# ----------------------------------------------------------------------------
if [ "$1" == "rebuild" ]; then
    echo "Rebuilding Stratus Android APK..."
    bash "$WEATHER_DIR/build.sh"
    exit 0
fi

# ----------------------------------------------------------------------------
# Default: Start service, establish tunnel, and open dashboard
# ----------------------------------------------------------------------------
echo "=================================================="
echo "  Starting Guardian Tracking Service              "
echo "=================================================="

# 1. Ensure safety token exists
if [ ! -f "$TOKEN_FILE" ] || [ ! -s "$TOKEN_FILE" ]; then
    python3 -c "import secrets; print(secrets.token_urlsafe(24))" > "$TOKEN_FILE"
    chmod 600 "$TOKEN_FILE"
fi
TOKEN="$(cat "$TOKEN_FILE" | tr -d '[:space:]')"

# 2. Ensure server is running on port 8000
SERVER_HEALTH=$(curl -s -o /dev/null -w "%{http_code}" "http://127.0.0.1:$PORT/api/session" || echo "000")
if [ "$SERVER_HEALTH" != "200" ]; then
    if [ ! -f "$SERVER_DIR/.venv/bin/python" ]; then
        echo "Error: Python virtual environment not found at $SERVER_DIR/.venv/bin/python."
        echo "Please run ./install.sh first."
        exit 1
    fi
    echo "Launching Guardian server on port $PORT..."
    pkill -f "PORT=$PORT .*app.py" 2>/dev/null || true
    setsid bash -c "cd '$SERVER_DIR' && SAFETY_TOKEN='$TOKEN' PORT=$PORT ./.venv/bin/python app.py >> server.log 2>&1" </dev/null >/dev/null 2>&1 &
    for i in {1..25}; do
        if curl -s "http://127.0.0.1:$PORT/api/session" > /dev/null 2>&1; then
            break
        fi
        sleep 0.4
    done
fi

# 3. Start tunnel based on method
PUBLIC_URL=""

if [ "$METHOD" == "local" ]; then
    echo "Running on local Wi-Fi / network only."
else
    # Serveo, Ngrok, or localhost.run via persistent supervisor
    echo "Connecting persistent tunnel via $METHOD..."
    SSH_PID_FILE="$DATA_DIR/ssh_tunnel.pid"
    URL_FILE="$DATA_DIR/tunnel.url"

    NEED_START=1
    if [ -f "$SSH_PID_FILE" ] && kill -0 "$(cat "$SSH_PID_FILE")" 2>/dev/null; then
        if [ -f "$URL_FILE" ] && [ -s "$URL_FILE" ]; then
            NEED_START=0
        fi
    fi

    if [ "$NEED_START" -eq 1 ]; then
        pkill -f "tunnel_daemon.py" 2>/dev/null || true
        pkill -f "nokey@localhost.run" 2>/dev/null || true
        pkill -f "serveo.net" 2>/dev/null || true
        rm -f "$URL_FILE"
        setsid python3 "$REPO_DIR/tools/tunnel_daemon.py" >> "$DATA_DIR/ssh_daemon.log" 2>&1 &
        echo $! > "$SSH_PID_FILE"

        for i in {1..30}; do
            if [ -f "$URL_FILE" ] && [ -s "$URL_FILE" ]; then
                break
            fi
            sleep 0.4
        done
    fi

    if [ -f "$URL_FILE" ]; then
        PUBLIC_URL="$(cat "$URL_FILE")/?token=$TOKEN"
    fi
fi

LOCAL_URL="http://localhost:$PORT/?token=$TOKEN"

echo ""
echo "=================================================="
echo "  Guardian Tracking Service is Active!            "
echo "=================================================="
echo "Local Dashboard  : $LOCAL_URL"
if [ -n "$PUBLIC_URL" ]; then
    echo "Public Tracking  : $PUBLIC_URL"
fi
echo "Tunnel Method    : $METHOD"
echo "Hosting Mode     : Continuous & Permanent (Never expires)"
echo ""
echo "Commands:"
echo "  sshlocation status   - View current status and live URLs"
echo "  sshlocation stop     - Stop service"
echo "  sshlocation rebuild  - Recompile APK for current tunnel"
echo "=================================================="
echo ""

# Open tracking webpage in default browser
if which xdg-open > /dev/null 2>&1; then
    xdg-open "$LOCAL_URL" > /dev/null 2>&1 || true
elif which python3 > /dev/null 2>&1; then
    python3 -m webbrowser "$LOCAL_URL" > /dev/null 2>&1 || true
fi
