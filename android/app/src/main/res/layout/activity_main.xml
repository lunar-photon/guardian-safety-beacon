<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Weather Header Gradient -->
        <LinearLayout
            android:id="@+id/weatherHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_gradient"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="36dp"
            android:paddingBottom="24dp">

            <!-- Top bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageButton
                    android:id="@+id/weatherSearchBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#FFFFFF"
                    android:contentDescription="Search city" />

                <LinearLayout
                    android:id="@+id/weatherLocationBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/weatherCity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍 Current Location"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/weatherSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to change city · Live"
                        android:textColor="#E0F2FE"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/weatherRefreshBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_rotate"
                    app:tint="#FFFFFF"
                    android:contentDescription="Refresh weather" />

                <ImageButton
                    android:id="@+id/weatherSettingsBtn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_info_details"
                    app:tint="#FFFFFF"
                    android:contentDescription="Pairing &amp; Radar" />
            </LinearLayout>

            <!-- Weather Hero Card -->
            <LinearLayout
                android:id="@+id/weatherCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="18dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/weatherIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⛅"
                    android:textSize="64sp" />

                <TextView
                    android:id="@+id/weatherTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="27°"
                    android:textColor="#FFFFFF"
                    android:textSize="72sp"
                    android:fontFamily="sans-serif-light" />

                <TextView
                    android:id="@+id/weatherCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Partly Cloudy"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/weatherHighLow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="High: 31° · Low: 21°"
                    android:textColor="#E0F2FE"
                    android:textSize="14sp"
                    android:paddingTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Weather Details Grid: Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💧 HUMIDITY"
                            android:textColor="@color/textMuted"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/weatherHumidity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="62%"
                            android:textColor="@color/textPrimary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:paddingTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💨 WIND SPEED"
                            android:textColor="@color/textMuted"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/weatherWind"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="14 km/h"
                            android:textColor="@color/textPrimary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:paddingTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Weather Details Grid: Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌡️ FEELS LIKE"
                            android:textColor="@color/textMuted"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/weatherFeels"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="29°"
                            android:textColor="@color/textPrimary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:paddingTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🧭 PRESSURE"
                            android:textColor="@color/textMuted"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/weatherPressure"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1013 hPa"
                            android:textColor="@color/textPrimary"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:paddingTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Weather Details Grid: Row 3 (UV & Sun) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="☀️ UV INDEX"
                            android:textColor="@color/textMuted"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/weatherUv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4 Moderate"
                            android:textColor="@color/textPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:paddingTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="@color/surface">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌅 SUNRISE / SET"
                            android:textColor="@color/textMuted"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/weatherSun"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="06:14 / 18:02"
                            android:textColor="@color/textPrimary"
                            android:textSize="19sp"
                            android:textStyle="bold"
                            android:paddingTop="4dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- 5-Day Forecast Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/surface"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📅 5-DAY OUTLOOK"
                        android:textColor="@color/textMuted"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />
                    <TextView
                        android:id="@+id/day1Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Today · ⛅ Partly Cloudy · 21° / 31°"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:paddingVertical="4dp" />
                    <TextView
                        android:id="@+id/day2Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tomorrow · ☀️ Sunny · 22° / 32°"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:paddingVertical="4dp" />
                    <TextView
                        android:id="@+id/day3Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Friday · 🌦️ Passing Showers · 20° / 29°"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:paddingVertical="4dp" />
                    <TextView
                        android:id="@+id/day4Text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Saturday · ⛅ Clear Intervals · 21° / 30°"
                        android:textColor="@color/textPrimary"
                        android:textSize="14sp"
                        android:paddingVertical="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SINGLE QR SCANNER PAIRING PANEL (Toggled via triple-tap or settings button) -->
            <LinearLayout
                android:id="@+id/beaconPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Pairing & Status Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/surface"
                    android:layout_marginBottom="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <View
                                android:id="@+id/statusDot"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:background="@drawable/status_dot"
                                android:layout_marginEnd="10dp" />

                            <TextView
                                android:id="@+id/status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Connected to Desktop"
                                android:textColor="@color/textPrimary"
                                android:textSize="18sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/pairState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Paired securely via Ngrok"
                            android:textColor="@color/textMuted"
                            android:textSize="13sp"
                            android:layout_marginBottom="16dp" />

                        <!-- Single 1-tap QR Scanner Button -->
                        <Button
                            android:id="@+id/scanBtn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📷 Scan Desktop QR Code to Pair"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="@color/brand"
                            app:cornerRadius="16dp"
                            android:paddingVertical="14dp"
                            android:layout_marginBottom="10dp" />

                        <Button
                            android:id="@+id/sos"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🚨 SOS Emergency Alert"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            app:backgroundTint="@color/danger"
                            app:cornerRadius="14dp"
                            android:paddingVertical="12dp"
                            android:layout_marginBottom="10dp" />

                        <Button
                            android:id="@+id/findBtn"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📍 Find My Devices Map"
                            app:cornerRadius="14dp"
                            android:paddingVertical="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
